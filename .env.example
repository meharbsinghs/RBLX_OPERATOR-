# ============================================================================
#  RBLX OPERATOR — environment template
#  Copy to .env and fill in the keys you have. EVERYTHING works with zero
#  keys: `newgame --offline` derives a themed game from your prompt text, and
#  all art is procedural. The engine ships no games — keys are optional
#  upgrades, never requirements. .env is gitignored — never commit it.
# ============================================================================

# --- Game design brain (optional, recommended) ------------------------------
# DeepSeek designs the full GameSpec from your prompt. Get a key at
# https://platform.deepseek.com — it's a few dollars for hundreds of designs.
DEEPSEEK_API_KEY=

# --- 3D asset generation (optional) ------------------------------------------
# Meshy text-to-3D for on-demand models. Get a key at https://www.meshy.ai
MESHY_API_KEY=
MESHY_ART_STYLE=low-poly
MESHY_TARGET_POLYCOUNT=4000

# --- Roblox Open Cloud (optional) --------------------------------------------
# Auto-uploads generated .glb models straight to Roblox and returns a live
# rbxassetid:// link — no manual Studio importing. Create an Open Cloud API
# key with the Assets:Write scope at https://create.roblox.com/dashboard/credentials
OPEN_CLOUD_API_KEY=
# Only set when your API key does not carry a creator scope:
# OPEN_CLOUD_CREATOR_ID=

# --- OpenCode operator (optional) --------------------------------------------
# OpenCode (https://opencode.ai) is the open-source coding agent used by
# `bridge.js operator "<task>"`. Configure the model + auth via:
#     opencode auth login --provider deepseek
OPENCODE_MODEL=deepseek/deepseek-chat
OPENCODE_AGENT=build
# Windows: OpenCode requires Git Bash. Point it at git-bash.exe if not on PATH.
# OPENCODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# --- Pipeline behavior -------------------------------------------------------
# Set to "false" to force offline text derivation even with a key
# (or pass --offline to the newgame command).
# USE_DEEPSEEK=true

# --- Project preferences -----------------------------------------------------
ROBLOX_PROJECT_NAME=RBLXOperator
COMPILATION_MODE=strict
