{
  "name": "rblx-operator",
  "version": "1.1.0",
  "description": "RBLX Operator — free, open-source Roblox game engine, built on opencode. Ships complete, balanced, playable Roblox games from a single prompt. Includes Zombie Rush: Greenwood Siege, a complete 10-wave survival shooter.",
