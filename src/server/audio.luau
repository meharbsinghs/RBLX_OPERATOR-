--!strict
-- ============================================================================
--  Audio director — data-driven sound, music and ambience.
--
--  Reads the GameSpec's `audio` block (generated by the design AI / hand-tuned
--  in the spec). This is the engine's *craft* layer for sound: one table
--  controls the whole audio identity of a game — the mood of the map, the
--  tension curve of the music per round state, and every one-shot effect.
--
--  Everything is OPTIONAL. If config.audio is missing or `enabled` is not
--  true, the module is a silent no-op — the engine never breaks without
--  sound, and a game with no audio block still boots fine.
--
--  Sound ids are Roblox asset ids ("rbxassetid://…"). Find free sounds in the
--  Creator Hub → Audio library. Bad ids simply fail to load (no crash), and
--  the operator craft pass can inject real library ids into any game.
-- ============================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local constants = require(ReplicatedStorage:WaitForChild("constants"))
local config = require(ReplicatedStorage:WaitForChild("config"))

local audio = {}

type SoundSpec = { id: string, volume: number? }
type AudioBlock = {
    enabled: boolean?,
    masterVolume: number?,
    ambience: SoundSpec?,
    music: {
        lobby: SoundSpec?,
        intermission: SoundSpec?,
        combat: SoundSpec?,
        boss: SoundSpec?,
        victory: SoundSpec?,
        defeat: SoundSpec?,
    }?,
    sfx: { [string]: SoundSpec }?,
}

local folder: Folder? = nil
local ambientLoop: Sound? = nil
local musicLoop: Sound? = nil
local currentMusic: string? = nil
local masterVolume = 0.7

local function activeBlock(): AudioBlock?
    local candidate: any = config.audio
    if type(candidate) == "table" and candidate.enabled == true then
        return candidate :: AudioBlock
    end
    return nil
end

local function makeSound(spec: SoundSpec?, name: string): Sound
    local sound = Instance.new("Sound")
    sound.Name = name
    sound.SoundId = (spec and spec.id) or "rbxassetid://0"
    sound.Volume = (spec and spec.volume) or 0.5
    sound.Looped = false
    if folder then
        sound.Parent = folder
    end
    return sound
end

local function playMusic(layer: string)
    local block = activeBlock()
    if not block or not block.music then
        return
    end
    local musicLayer: SoundSpec? = nil
    if layer == "boss" then
        musicLayer = block.music.boss
    elseif layer == "victory" then
        musicLayer = block.music.victory
    elseif layer == "defeat" then
        musicLayer = block.music.defeat
    elseif layer == "intermission" then
        musicLayer = block.music.intermission
    elseif layer == "combat" then
        musicLayer = block.music.combat
    else
        musicLayer = block.music.lobby
    end
    if not musicLayer or not musicLayer.id then
        return
    end
    if currentMusic == layer and musicLoop then
        return
    end
    if musicLoop then
        musicLoop:Stop()
        musicLoop:Destroy()
        musicLoop = nil
    end
    musicLoop = makeSound(musicLayer, "Music_" .. layer)
    musicLoop.Looped = true
    musicLoop.Volume = (musicLoop.Volume or 0.5) * masterVolume
    musicLoop:Play()
    currentMusic = layer
end

function audio.init()
    local block = activeBlock()
    if not block then
        return
    end
    masterVolume = (block.masterVolume or 0.7)
    folder = Instance.new("Folder")
    folder.Name = constants.FOLDERS.Audio
    folder.Parent = workspace

    if block.ambience and block.ambience.id then
        ambientLoop = makeSound(block.ambience, "Ambience")
        ambientLoop.Looped = true
        ambientLoop.Volume = (ambientLoop.Volume or 0.5) * masterVolume
        ambientLoop:Play()
    end

    playMusic("lobby")
end

-- Called by rounds.luau as the game moves through states. Maps round states
-- to music layers, with a dedicated "boss" layer on boss rounds.
function audio.setIntensity(state: string, bossRound: boolean?)
    if state == "gameOver" then
        playMusic("defeat")
        return
    end
    if state == "combat" then
        playMusic(bossRound == true and "boss" or "combat")
        return
    end
    playMusic(state == "intermission" and "intermission" or "lobby")
end

-- Extraction/objective win — a distinct celebratory layer.
function audio.celebrate()
    playMusic("victory")
end

-- One-shot SFX. Fires from combat/shop/etc. Named by the spec's sfx table.
function audio.play(name: string)
    local block = activeBlock()
    if not block or not block.sfx then
        return
    end
    local spec = block.sfx[name]
    if not spec then
        return
    end
    local sound = makeSound(spec, "Sfx_" .. name)
    sound.Volume = (sound.Volume or 0.5) * masterVolume
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

return audio
