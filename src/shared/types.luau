--!strict
-- ============================================================================
--  Shared runtime types. Every gameplay module conforms to these shapes.
--  The GameSpec (config.luau) is generated against this exact schema.
-- ============================================================================

export type WeaponTier = {
    damageMultiplier: number,
    magMultiplier: number,
    nameSuffix: string,
}

export type WeaponSpec = {
    id: string,
    name: string,
    kind: "gun" | "melee",
    damage: number,
    headshotMultiplier: number,
    roundsPerSecond: number,
    magSize: number,
    reserve: number,
    reloadTime: number,
    spread: number,
    recoil: number,
    range: number,
    pellets: number,
    auto: boolean,
    wallBuyCost: number,
    ammoCost: number,
    color: Color3,
    packTiers: { WeaponTier },
}

export type EnemySpec = {
    id: string,
    name: string,
    baseHealth: number,
    healthPerRound: number,
    speed: number,
    damage: number,
    attackRate: number,
    points: number,
    hitPoints: number,
    color: Color3,
    scale: number,
    unlockRound: number,
    spawnWeight: number,
    isBoss: boolean,
}

export type PerkSpec = {
    id: string,
    name: string,
    cost: number,
    description: string,
    color: Color3,
}

export type DoorSpec = {
    id: string,
    name: string,
    cost: number,
    from: string,
    to: string,
}

export type ZoneSpec = {
    id: string,
    center: Vector3,
    size: Vector3,
    door: string?,
    windows: { string },
}

export type RepairZoneSpec = {
    id: string,
    position: Vector3,
    cost: number,
}

export type StatusLightSpec = {
    id: string,
    position: Vector3,
    color: Color3,
    range: number,
    label: string?,
}

export type LightingProfile = {
    ambient: Color3,
    outdoor: Color3,
    shiftTop: Color3,
    shiftBottom: Color3,
    brightness: number,
    clockTime: number,
    exposure: number,
    fogStart: number,
    fogEnd: number,
    atmosphereDensity: number,
    atmosphereOffset: number,
    atmosphereGlare: number,
    atmosphereHaze: number,
    skyColor: Color3,
}

export type MapSpec = {
    name: string,
    theme: {
        floor: Color3,
        wall: Color3,
        accent: Color3,
        fog: Color3,
        lighting: LightingProfile,
    },
    spawn: Vector3,
    zones: { ZoneSpec },
    doors: { DoorSpec },
    wallBuys: { { id: string, weaponId: string, position: Vector3 } },
    boxes: { { id: string, position: Vector3 } },
    perks: { { id: string, perkId: string, position: Vector3 } },
    pack: Vector3,
    repairZones: { RepairZoneSpec },
    statusLights: { StatusLightSpec },
}

export type PlayerLoadout = {
    equipped: string,
    weapons: { [string]: number },
    ammo: { [string]: { mag: number, reserve: number } },
}

export type RoundState = "lobby" | "intermission" | "spawning" | "combat" | "roundEnd" | "gameOver"

-- Engine-level config blocks added by the pipeline. The runtime reads these
-- defensively (they are optional in specs generated by older toolchains).
export type AnticheatSpec = {
    enabled: boolean,
    maxSpeed: number,
    teleportThreshold: number,
    strikesBeforeAction: number,
    action: string,
}

export type StyleGuide = {
    material: string,
    eyeColor: { number }?,
}

export type NetSpec = {
    enemyBatchHz: number,
}
